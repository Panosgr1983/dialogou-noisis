# Environment variables — ΑΝΤΙΓΡΑΨΕ σε .env (ποτέ commit το .env)
# Οι τιμές δίνονται χωριστά από τον ιδιοκτήτη.

# Χρησιμοποιούνται και σε SSR (χωρίς VITE_) και σε client build (με VITE_)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Προαιρετικό: κανονικό domain για canonical/OG/sitemap.
# Αν δεν οριστεί, χρησιμοποιείται το https://dialogou-noisis.vercel.app
# VITE_SITE_URL=https://dialogounoisis.gr
